# Copy to .env and fill in. See README.md "Quickstart" for where each key comes from.
# .env is gitignored; this file is the only one that should ever be committed.

# 32+ random characters. Gates /b/:secret/* (the broadcaster's Director, Vonage-publish and
# fal-proxy routes) so a stranger can't open a billed Director session. Generate with e.g.
# `openssl rand -hex 32`.
BROADCASTER_SECRET=

# fal dashboard -> API Keys (fal.ai/dashboard/keys). Server-side only: the fal proxy in
# src/mastra/index.ts reads this to open and steer the Director session. Never expose it to
# the browser.
FAL_KEY=

# Nebius Token Factory -> API keys (tokenfactory.nebius.com). Powers moderation and the scene
# writer through Mastra's built-in `nebius/<model>` router (src/mastra/showrunner.ts).
NEBIUS_API_KEY=

# Vonage dashboard -> Applications -> Create a new application -> enable Video -> Application ID.
VONAGE_APPLICATION_ID=

# Same application's private key, base64-encoded. The dashboard downloads the key as a .pem file;
# encode it with `base64 -i private.pem | tr -d '\n'`.
VONAGE_PRIVATE_KEY64=

# app.slng.ai -> Projects -> New project -> Generate key. Copy it now: SLNG only shows it once.
# Used for the "up next" announcer clip (src/mastra/announcer.ts).
SLNG_API_KEY=

# BotFather (t.me/BotFather) -> /newbot -> copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# Optional. Public URL the Telegram bot links to in DMs (src/mastra/telegram.ts). Defaults to
# http://localhost:4111 if unset, which is fine for local runs.
PUBLIC_URL=

# Optional. HTTP port for the Mastra server. Defaults to 4111.
PORT=
